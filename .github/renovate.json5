{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>corrupt952/renovate-config:default.json5",
  ],
  mise: {
    managerFilePatterns: ["/^config\\.toml$/"],
  },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^config\\.toml$/"],
      matchStrings: [
        'url = "https://github\\.com/(?<depName>[^"]+)\\.git", ref = "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "github-tags",
    },
  ],
}
